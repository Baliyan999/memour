# Settings for scripts/deploy.sh. Copy to scripts/deploy.env (git-ignored)
# and fill in. Plain KEY=VALUE lines; environment variables win over this
# file. Commented lines show the defaults. docs/DEPLOY.md §6.

# ssh target: user@host, or a Host alias from ~/.ssh/config (put the port,
# key and user there). Required.
DEPLOY_HOST=memour@your-server.example

# The live release: the unit's WorkingDirectory. The script keeps its
# siblings next to it (APP_DIR-next, APP_DIR-prev-<sha>, APP_DIR-failed-*,
# APP_DIR-env-backups, APP_DIR-deploy.log), so the ssh user must be able to
# create directories in its parent.
#APP_DIR=/var/www/memour
#SERVICE=memour

# NITRO_PORT of the unit (what nginx proxies to) and the port for the trial
# run of a new build.
#APP_PORT=3300
#TRIAL_PORT=3399

# Previous releases kept for rollback; older ones are deleted after a
# successful deploy. Each is ~1 GB with node_modules.
#KEEP_RELEASES=2

# Seconds a new release gets to answer /api/health.
#HEALTH_TIMEOUT=60

# Shown after a failed health check.
#SERVICE_LOG=/var/log/memour.log

# systemctl for start/stop. Default: plain systemctl as root, else
# "sudo -n systemctl" (needs the sudoers rule from docs/DEPLOY.md §1).
#SYSTEMCTL=sudo -n systemctl

# Only if node / pnpm aren't on the PATH of a non-interactive ssh session
# (e.g. installed with nvm).
#NODE=/usr/bin/node
#PNPM=/usr/bin/pnpm

# The git remote and branch: the default ref, and what "pushed" means.
#DEPLOY_REMOTE=origin
#DEPLOY_BRANCH=main
