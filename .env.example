# =============================================================================
# Memour env — copy to .env and fill in your own values.
# =============================================================================

# --- Public site URL (used for QR generation + Telegram deep links + Supabase
#     magic-link redirect target). Set to your production domain on deploy.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=<anon public key>
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# --- Telegram bot (outbound notifications: leads + new photos) --------------
# Optional. Without these, /api/lead silently skips Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LEAD_CHAT_ID=

# --- Eskiz SMS gateway ------------------------------------------------------
# Get from Eskiz → СМС шлюз (not the personal cabinet password!)
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
# Set to 'false' AFTER your custom template "Код подтверждения для входа на
# сайт Memour: 000000. Никому не сообщайте код." is approved.
ESKIZ_USE_TEST_TEMPLATE=true

# --- Payments (fill after merchant approval) --------------------------------
# Without these the checkout falls back to dev mode (marks paid instantly).
# PAYME_MERCHANT_ID=
# PAYME_MERCHANT_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
