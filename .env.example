# =============================================================================
# Memour env — copy to .env and fill in your own values.
# Production: every variable lives in the runtime env file of the process
# manager (docs/DEPLOY.md → Environment); server/plugins/env-check.ts
# validates them at startup.
# =============================================================================

# --- Public site URL (QR codes, login links, canonical/hreflang, Supabase
#     magic-link redirect target). No trailing slash. Production:
#     https://memour.uz
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=<anon public key>
# Service-role key, read at runtime only (never baked into .output).
# NUXT_SUPABASE_SECRET_KEY is the same thing under the module's own name.
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# --- Telegram bot (lead + payment alerts, admin 2FA codes) --------------------
# Optional locally. Without the token nobody can log into /admin (the
# second factor is a Telegram code); without the chat id leads still reach
# the DB but nobody is pinged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LEAD_CHAT_ID=

# --- Admin 2FA session signing (REQUIRED in prod, >= 32 chars) ---------------
# Signs the httpOnly admin-2FA cookie. Without it production refuses admin
# login (503); `pnpm dev` uses a per-process secret. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Eskiz SMS gateway ------------------------------------------------------
# Get from Eskiz → СМС шлюз (not the personal cabinet password!)
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
# 'true' switches to Eskiz' fixed test text ("Bu Eskiz dan test"), which
# can't carry the login code: production then turns SMS login off (couples
# use the email link) and admin-created events send no SMS. Keep 'true' in
# production only until Eskiz approves the Memour templates, then 'false'.
# Locally, `pnpm dev` prints the login code to the server console, so you
# don't need Eskiz at all.
ESKIZ_USE_TEST_TEMPLATE=false
# Site-wide ceiling on login SMS per hour before SMS login pauses and the
# founder gets a Telegram alert (default 200). Tune to the Eskiz budget.
# OTP_SMS_HOURLY_CAP=200

# --- Payments (fill after merchant approval) --------------------------------
# A provider without ALL its keys is closed: checkout answers 503
# payments_unavailable and the dashboard hides its button (half a set
# stops a production server from starting).
# Payme (Merchant API endpoint: <site>/api/payments/payme/webhook)
# PAYME_MERCHANT_ID=
# PAYME_MERCHANT_KEY=          # sandbox: the TEST_KEY; production: the cashbox key
# PAYME_LOGIN=Paycom           # Basic-auth login, only if Payme gave you another one
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz   # sandbox: https://test.paycom.uz
# Fiscal receipt line (tax rules; the detail is omitted until all three are set)
# PAYME_IKPU_CODE=             # ИКПУ of the service, tasnif.soliq.uz
# PAYME_PACKAGE_CODE=          # package code from the same ИКПУ card
# PAYME_VAT_PERCENT=           # 12 if the company pays VAT, 0 otherwise — ask the accountant
# Click (Prepare + Complete URL: <site>/api/payments/click/webhook)
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# Local development only: mark payments paid instantly without a provider.
# Ignored in production builds (NODE_ENV=production).
# PAYMENTS_DEV_MODE=true

# --- Legal documents -----------------------------------------------------------
# The operator's details for the full privacy policy / terms / public offer
# (shared/legal.ts). Until the required ones are set — and the generated texts
# have no open placeholders or todo items — the short interim /privacy and
# /terms are served.
# *_RU variants override a value in the Russian text (default: the same value).
# NUXT_PUBLIC_LEGAL_ENTITY_NAME=              # «Memour» MChJ — full name with legal form
# NUXT_PUBLIC_LEGAL_ENTITY_NAME_RU=
# NUXT_PUBLIC_LEGAL_ENTITY_INN=
# NUXT_PUBLIC_LEGAL_ENTITY_REGISTRATION=      # № …, date, registering body
# NUXT_PUBLIC_LEGAL_ENTITY_REGISTRATION_RU=
# NUXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
# NUXT_PUBLIC_LEGAL_ENTITY_ADDRESS_RU=
# NUXT_PUBLIC_LEGAL_ENTITY_POSTAL_ADDRESS=     # optional, defaults to the address
# NUXT_PUBLIC_LEGAL_ENTITY_POSTAL_ADDRESS_RU=
# NUXT_PUBLIC_LEGAL_ENTITY_PHONE=
# NUXT_PUBLIC_LEGAL_ENTITY_EMAIL=             # optional, defaults to hello@memour.uz
# NUXT_PUBLIC_LEGAL_ENTITY_BANK=              # bank, MFO, account
# NUXT_PUBLIC_LEGAL_ENTITY_BANK_RU=
# NUXT_PUBLIC_LEGAL_EFFECTIVE_DATE=           # YYYY-MM-DD the published texts take effect
# Review the drafts on a local / staging server — never in production:
# NUXT_PUBLIC_LEGAL_PREVIEW=true

# --- Retention -----------------------------------------------------------------
# A daily task (03:00 server time) deletes the media of events past
# archive_expires_at (wedding + 180 days, 365 for Luxury). Dry run (log
# only) unless 'true'. See README → Retention.
RETENTION_PURGE_ENABLED=

# --- Server (production) ------------------------------------------------------
# Listen on loopback only, behind nginx, which must set X-Real-IP and
# X-Forwarded-For (docs/DEPLOY.md → nginx) — every per-IP limit keys on them.
# HOST=127.0.0.1
# PORT=3000
# Only for a build made with an http:// site URL that is served over https.
# NUXT_PUBLIC_SUPABASE_COOKIE_OPTIONS_SECURE=true
